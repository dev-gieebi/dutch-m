# URL publique de l'API Laravel (sans /api/v1)
VITE_API_URL=http://localhost:8000
# URL publique de la boutique (balises canoniques, Open Graph)
VITE_SITE_URL=http://localhost:5173

# Temps réel (Laravel Reverb) : laisser VITE_REVERB_APP_KEY vide pour désactiver
# (la clé doit correspondre à REVERB_APP_KEY du backend).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
