<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{subject}}</title>
</head>
<body style="margin:0;padding:0;background:#FCFAF5;font-family:Montserrat,Arial,sans-serif;color:#2B2115;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FCFAF5;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#FFFFFF;border-radius:16px;overflow:hidden;">
          <tr>
            <td style="padding:28px 32px;text-align:center;background:linear-gradient(135deg,#F2CF62 0%,#D4A12A 50%,#9A6712 100%);">
              <div style="font-family:'Cormorant Garamond',Georgia,serif;font-size:30px;letter-spacing:0.12em;color:#ffffff;font-weight:700;">{{shopName}}</div>
              <div style="font-size:12px;letter-spacing:0.08em;color:#ffffff;text-transform:uppercase;">{{shopTagline}}</div>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;font-size:15px;line-height:1.6;">
              {{{content}}}
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;background:#F2E9D6;font-size:12px;color:#73634B;text-align:center;">
              {{shopName}} – {{shopAddress}}<br>
              WhatsApp : {{whatsappNumber}} · {{shopEmail}}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
