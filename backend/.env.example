# =============================================================================
# DutCh’M API (Laravel) — variables d'environnement
# =============================================================================

# --- Application ---------------------------------------------------------------
APP_NAME="DutCh’M API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Libreville
APP_URL=https://dutch-m.com/
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# URL publique du site (boutique servie par Laravel) : canoniques, sitemap, liens des e-mails
WEB_PUBLIC_URL=https://dutch-m.com/
ADMIN_PUBLIC_URL=https://dutch-m.com/admin
# Origines autorisées pour le front en développement séparé (npm run dev). En local, tout port localhost est accepté.
CORS_ORIGINS=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données MySQL (WampServer) ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql4201.lwspanel.com
DB_PORT=3306
DB_DATABASE=dutch2906308
DB_USERNAME=dutch2906308
DB_PASSWORD=bB5_F515EPrbfR-

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Authentification (JWT + cookie de rafraîchissement) ----------------------
JWT_ADMIN_ACCESS_SECRET=
JWT_CUSTOMER_ACCESS_SECRET=
JWT_TEMP_SECRET=
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
TOTP_ISSUER="DutCh’M Admin"

# --- Fichiers téléversés (servis sous /uploads) --------------------------------
UPLOAD_DIR=storage/app/uploads
UPLOAD_MAX_MB=8

# --- E-mails (SMTP) ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@amoria.ga"
MAIL_FROM_NAME="DutCh’M"

# --- SMS / WhatsApp ------------------------------------------------------------------
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=DUTCHM
WHATSAPP_PROVIDER=log
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Paiements -------------------------------------------------------------------------
PAYMENT_MODE=mock
MOCK_WEBHOOK_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=GA
AIRTEL_CURRENCY=XAF
AIRTEL_WEBHOOK_SECRET=
MOOV_BASE_URL=https://api.moov-africa.ga
MOOV_MERCHANT_ID=
MOOV_API_KEY=
MOOV_API_SECRET=
MOOV_WEBHOOK_SECRET=

# --- Limitation de débit (requêtes / minute / IP) ----------------------------------
THROTTLE_LIMIT=120

# --- Temps réel (Laravel Reverb) ----------------------------------------------------
# Temps réel : lancer `php artisan reverb:start` (inclus dans `composer dev`). Mettre `log` pour le désactiver.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Seed administrateur (php artisan db:seed) -------------------------------------
SEED_ADMIN_FULL_NAME="Super admin DutCh’M"
SEED_ADMIN_EMAIL=superadmin@amoria.ga
SEED_ADMIN_PASSWORD=12345678
